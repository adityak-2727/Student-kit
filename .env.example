# Placeholder template only. Copy to untracked .env.local; never send secrets in chat.
# The public foundation runs without a local env file or external accounts.
# Never expose secrets through NEXT_PUBLIC_. Next.js owns NODE_ENV.
APP_ORIGIN=http://localhost:3000
APP_MODE=foundation

# Reserved integration prerequisites; not consumed by the foundation.
# Map explicitly to NextAuth v4 options when authentication is implemented.
# No live/demo mode or test identity bypass exists in this build.
AUTH_SECRET=replace_with_independent_random_secret
AUTH_GOOGLE_ID=replace_with_google_web_client_id
AUTH_GOOGLE_SECRET=replace_with_google_client_secret

MONGODB_URI=replace_with_tls_atlas_uri_for_this_environment
MONGODB_DB=daylight_dev
MONGODB_KEY_VAULT_NAMESPACE=daylight_dev_keys.__keyVault

# HMAC lookup key is independent of authentication and encryption keys.
IDENTITY_HMAC_KEY_BASE64=replace_with_at_least_32_random_bytes_base64
IDENTITY_HMAC_KEY_VERSION=1

# local allowed only for development/test; production must use a verified KMS.
ENCRYPTION_PROVIDER=local
LOCAL_CSFLE_MASTER_KEY_BASE64=replace_with_96_random_bytes_base64_dev_only
KMS_AWS_REGION=replace_if_using_aws_kms
KMS_AWS_KEY_ARN=replace_if_using_aws_kms
# Prefer workload identity. Wire any provider credentials via the host secret store.

# Bypass is rejected in every environment in this build.
ENABLE_TEST_AUTH=false
