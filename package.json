{
  "name": "daylight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "dev": "node scripts/check-config.ts && next dev --hostname 127.0.0.1",
    "build": "node scripts/check-config.ts --production && next build",
    "start": "node scripts/check-config.ts --production && next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "config:check": "node scripts/check-config.ts",
    "audit": "pnpm audit --audit-level high",
    "audit:production": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@next/env": "16.4.0", "luxon": "3.7.2", "next": "16.4.0",
    "react": "19.3.0", "react-dom": "19.3.0", "server-only": "0.0.1", "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0", "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6", "@types/node": "24.19.2",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "eslint": "9.39.5", "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3", "typescript": "5.9.3", "vitest": "5.0.4"
  }
}
