{
  "name": "daylight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node scripts/check-config.ts && next dev --hostname 127.0.0.1",
    "build": "node scripts/check-config.ts --production && next build",
    "start": "node --conditions=react-server scripts/check-config.ts --production --dependencies && next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --conditions=react-server scripts/migrate-database.ts",
    "encryption:verify": "node --conditions=react-server scripts/check-encryption.ts",
    "encryption:runtime": "node scripts/native-encryption-runtime.mjs",
    "test:e2e": "playwright test",
    "test:shell": "playwright test --config playwright.shell.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "config:check": "node scripts/check-config.ts",
    "config:keys": "node scripts/prepare-private-keys.ts",
    "security:client-secrets": "node scripts/check-client-secrets.ts",
    "audit": "pnpm audit --audit-level high",
    "audit:production": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1148.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@next/env": "16.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "lucide-react": "1.56.0",
    "luxon": "3.7.2",
    "mongodb": "7.7.0",
    "mongodb-client-encryption": "7.2.1",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
